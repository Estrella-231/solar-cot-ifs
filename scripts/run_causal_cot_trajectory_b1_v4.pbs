#!/bin/bash
#PBS -N hn_cot_traj_b1
#PBS -q gpu
#PBS -l nodes=node21:ppn=8:gpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/causal_cot_trajectory_b1_20260918.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH"
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"; test "$(echo "$GPU" | wc -l)" -eq 1; export CUDA_VISIBLE_DEVICES="$GPU"
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
FORECAST="$ROOT/data/forecast_cot_trajectory_trainval_20260918_v1"
HISTORY="$ROOT/data/history_cot_trajectory_trainval_20260918_v1"
OUT="$ROOT/runs/causal_cot_trajectory_b1_seed42_20260918_v4"
test -f "$FORECAST/audit.json"; test -f "$HISTORY/audit.json"; test ! -e "$OUT"; cd "$ROOT"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total --format=csv
python -u scripts/train_causal_cot_trajectory_v4.py --root "$ROOT" --forecast-dir "$FORECAST" --history-dir "$HISTORY" --out "$OUT" --epochs 10 --batch 2048 --seed 42 --allow-unverified-cpp
echo CAUSAL_COT_TRAJECTORY_B1_COMPLETE
