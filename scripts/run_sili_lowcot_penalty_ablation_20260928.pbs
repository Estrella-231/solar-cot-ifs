#!/bin/bash
#PBS -N sili_loss_ablate
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/regional_station_cot_20260925/sili_lowcot_penalty_ablation_seed42_20260928_v1.pbs.log
set -euo pipefail
trap 'rc=$?; echo "FAILED: line=$LINENO status=$rc"; exit "$rc"' ERR
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$ROOT/experiments/regional_station_cot_20260925
BANK=$EXP/sili_cot_dynamics_bank_train512_val512_20260927_v1
OUT=$EXP/sili_lowcot_penalty_ablation_seed42_20260928_v1
TMP=${TMPDIR:-/tmp}/sili_loss_ablate_${PBS_JOBID%%.*}
test -s "$BANK/complete.json"
test ! -e "$OUT"
python -m py_compile "$ROOT/scripts/train_sili_transport_thickness_pilot_20260927.py" "$ROOT/scripts/train_sili_lowcot_penalty_ablation_20260928.py"
mkdir -p "$TMP/bank"
df -Pk "$TMP" | awk 'NR==2 { if ($4 < 5000000) exit 1 }'
cp "$BANK/complete.json" "$TMP/bank/complete.json"
cp -a "$BANK/train" "$BANK/val" "$TMP/bank/"
sha256sum "$ROOT/scripts/train_sili_lowcot_penalty_ablation_20260928.py" "$TMP/bank/complete.json"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.total,memory.used,utilization.gpu --format=csv
python -u "$ROOT/scripts/train_sili_lowcot_penalty_ablation_20260928.py" --bank "$TMP/bank" --output "$OUT" --epochs 40 --batch-size 8
echo SILI_LOW_COT_PENALTY_ABLATION_COMPLETE
