#!/bin/bash
#PBS -N hn_cot_spatial_smoke
#PBS -q gpu
#PBS -l nodes=node21:ppn=8:gpus=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/spatial_smoke_20260917_v2_pbs.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH"
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"; test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
cd "$ROOT"
date -Is; hostname
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total --format=csv
python -u scripts/spatial_head_smoke_v1.py --root "$ROOT" --sidecar "$ROOT/data/head_spatial_cot_trainval_20260917_v2" --output "$ROOT/audits/spatial_b0_20260917_v2"
echo SPATIAL_COT_SMOKE_COMPLETE
