#!/bin/bash
#PBS -N hn_frozen_cache
#PBS -q gpu
#PBS -l nodes=node21:ppn=8:gpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/forecast_cache_pbs.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-}"
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test "$(echo "$GPU" | wc -l)" -eq 1
test -n "$GPU"
export CUDA_VISIBLE_DEVICES="$GPU"
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
export PYTHONPATH=/public/home/slfu/ttzhou/swc/irradiance_forecast/HunanSimVPDDP_20260907/scripts
cd "$ROOT"
hostname
date -Is
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total --format=csv
python -u scripts/cache_frozen_forecast.py --project "$ROOT" --output "$ROOT/data/frozen_forecast_trainval_20260907_v1" > forecast_cache.log 2>&1
