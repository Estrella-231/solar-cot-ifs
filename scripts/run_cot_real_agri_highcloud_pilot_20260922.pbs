#!/bin/bash
#PBS -N hn_cot_real_hi
#PBS -q gpu
#PBS -l nodes=node21:ppn=8:gpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/pbs_cot_real_agri_highcloud_pilot_20260922.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-}"
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu | head -1)
test -n "$GPU"
export CUDA_VISIBLE_DEVICES="$GPU"
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
cd "$ROOT"
hostname
date -Is
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total --format=csv
python -u scripts/train_cot_real_agri_highcloud_pilot_20260922.py \
  --root "$ROOT" \
  --output "$ROOT/runs/cot_real_agri_highcloud_pilot_seed42_20260922" \
  --epochs 24 --batch 256 --lr 0.0001 --high-weight 2.0 --seed 42 \
  > "$ROOT/cot_real_agri_highcloud_pilot_20260922.train.log" 2>&1
