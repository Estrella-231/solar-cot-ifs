#!/bin/bash
#PBS -N cot_region_ghi
#PBS -q gpu
#PBS -l nodes=node21:ppn=8:gpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/regional_station_cot_20260925/regional_ghi_pilot_20260927_v1.pbs.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast
SOLAR=$ROOT/SolarCOTIFS_20260907
EXP=$SOLAR/experiments/regional_station_cot_20260925
SCRIPT=$EXP/scripts
BANK=$EXP/regional_ghi_pilot_bank_20260927_v1
OUT=$EXP/regional_ghi_pilot_seed42_20260927_v1
test ! -e "$BANK"
test ! -e "$OUT"
grep -q COMPLETE_PAIRED_CPP_REFERENCE_AUDIT "$EXP/r_pair_audit_20260927_v1.log"
python -m py_compile "$SCRIPT/build_regional_cot_ghi_pilot_20260927.py" "$SCRIPT/train_regional_cot_ghi_pilot_20260927.py" "$SCRIPT/smoke_regional_cot_ghi_20260927.py"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.total --format=csv
python -u "$SCRIPT/smoke_regional_cot_ghi_20260927.py" --output "$EXP/regional_head_kernel_witness_20260927_v1.json"
python -u "$SCRIPT/build_regional_cot_ghi_pilot_20260927.py" \
 --solar-root "$SOLAR" --triad-root "$ROOT/HunanBackboneTriad_20260921" \
 --hunan-source "$ROOT/HunanSimVPFull_20260906" \
 --data-root /public/home/slfu/ttzhou/Auxiliary_data/HuNan_AGRI_Preprocessed \
 --r-run "$EXP/r256_full_exploratory_seed42_batch512_node22" \
 --r-cache "$EXP/agri_cpp_pair_bank_v1" \
 --output "$BANK" --train-sequences 512 --val-sequences 128
LOCAL=${TMPDIR:-/tmp}/regional_ghi_pilot_${PBS_JOBID//[^A-Za-z0-9]/_}
mkdir -p "$LOCAL"
BYTES=$(du -sb "$BANK" | awk '{print $1}')
AVAILABLE=$(df -PB1 "$LOCAL" | awk 'NR==2 {print $4}')
test "$AVAILABLE" -gt "$((BYTES+BYTES/10))"
cp -a "$BANK" "$LOCAL/bank"
python -u "$SCRIPT/train_regional_cot_ghi_pilot_20260927.py" \
 --bank "$LOCAL/bank" --base "$SOLAR/data/head_pack_trainval_20260908_v1" \
 --output "$OUT" --epochs 15 --minimum-updates 600 --patience 5 --workers 2 --seed 42
echo REGIONAL_GHI_PILOT_ALL_STAGES_COMPLETE
