#!/bin/bash
#PBS -N hb_cot13ddp4
#PBS -q gpu
#PBS -l nodes=node22:ppn=32:gpus=4
#PBS -l walltime=20:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_solar_geometry_repair_20261021/hubei_cot_auxiliary_retrain_attempt13_ddp4_20261021/ddp4.log
set -euo pipefail
BASE=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_solar_geometry_repair_20261021
ATTEMPT=$BASE/hubei_cot_auxiliary_retrain_attempt13_ddp4_20261021
SRC=$BASE/hubei_cot_auxiliary_retrain_attempt13_retry4
SHARED=$BASE/hubei_cot_auxiliary_retrain_attempt13
PY=/public/home/slfu/miniconda3/envs/swc/bin/python
GPU_TEXT=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'node22-gpu/[0-9]+' | cut -d/ -f2 | sort -un)
test "$(printf '%s\n' "$GPU_TEXT" | wc -l)" -eq 4
export CUDA_VISIBLE_DEVICES=$(printf '%s\n' "$GPU_TEXT" | paste -sd, -)
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONPATH="$SHARED/python_vendor:$SRC:$ATTEMPT${PYTHONPATH:+:$PYTHONPATH}"
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
cd "$ATTEMPT"
echo "DDP4_START job=$PBS_JOBID host=$(hostname) physical_GPUs=$CUDA_VISIBLE_DEVICES"
nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
test -z "$(nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-compute-apps=pid --format=csv,noheader)"
"$PY" -m torch.distributed.run --standalone --nnodes=1 --nproc_per_node=4 run_ddp_resume.py --root "$ATTEMPT" --mode probe
test -f PROBE_PASS.json
echo 'DDP4_PROBE_PASSED_WAITING_LATEST_COMPLETE_SOURCE_BACKUP'
# The controller creates this only after a final stable checkpoint backup and
# original-job shutdown. A failed probe never affects the original training.
for ((i=0;i<360;i++)); do
  if test -f CUTOVER_READY.json; then break; fi
  sleep 10
done
test -f CUTOVER_READY.json
BACKUP=$("$PY" -c 'import json;print(json.load(open("CUTOVER_READY.json"))["backup"])')
"$PY" prepare_resume.py --root "$ATTEMPT" --backup "$BACKUP" --mode full
"$PY" -m torch.distributed.run --standalone --nnodes=1 --nproc_per_node=4 run_ddp_resume.py --root "$ATTEMPT" --mode full
echo "DDP4_FULL_TRAIN_COMPLETE job=$PBS_JOBID physical_GPUs=$CUDA_VISIBLE_DEVICES"
