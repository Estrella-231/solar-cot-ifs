#!/bin/bash
#PBS -N hb_cot_aux13r4
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=36:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_solar_geometry_repair_20261021/hubei_cot_auxiliary_retrain_attempt13_retry4/retry4.log
set -euo pipefail

BASE=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_solar_geometry_repair_20261021
ATTEMPT=$BASE/hubei_cot_auxiliary_retrain_attempt13_retry4
SHARED=$BASE/hubei_cot_auxiliary_retrain_attempt13
PY=/public/home/slfu/miniconda3/envs/swc/bin/python

GPU_TEXT=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'node22-gpu/[0-9]+' | cut -d/ -f2 | sort -un)
if [ -z "$GPU_TEXT" ] || [ "$(printf '%s\n' "$GPU_TEXT" | wc -l)" -ne 1 ]; then
  echo "GPU_ASSIGNMENT_FAIL job=$PBS_JOBID host=$(hostname) value=$GPU_TEXT"
  exit 32
fi
export CUDA_VISIBLE_DEVICES="$GPU_TEXT"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONPATH="$SHARED/python_vendor:$ATTEMPT${PYTHONPATH:+:$PYTHONPATH}"
cd "$ATTEMPT"
"$PY" attempt13_import_smoke.py
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
echo "ATTEMPT13_RETRY4_START PBS=$PBS_JOBID HOST=$(hostname) PBS_GPU_ALLOCATION=node22-gpu/$GPU_TEXT"
nvidia-smi -i "$GPU_TEXT" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
test -z "$(nvidia-smi -i "$GPU_TEXT" --query-compute-apps=pid --format=csv,noheader)"
"$PY" -m py_compile attempt13_import_smoke.py build_cpp_target_sidecar_attempt13.py cot_aux_patch_attempt13.py prepare_attempt13_inputs.py profile_joint_step_attempt13.py run_cot_aux_simvp_attempt13.py run_pair_attempt13.py
"$PY" prepare_attempt13_inputs.py --base "$BASE" --attempt "$ATTEMPT" --python "$PY"
"$PY" run_pair_attempt13.py --base "$BASE" --attempt "$ATTEMPT" --python "$PY" --simvp-repo "$BASE/simvp_code_snapshot"
echo "ATTEMPT13_RETRY4_PAIR_JOB_COMPLETE PBS=$PBS_JOBID GPU=$GPU_TEXT"
