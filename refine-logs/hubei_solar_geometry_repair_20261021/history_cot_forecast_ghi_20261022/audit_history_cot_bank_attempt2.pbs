#!/bin/bash
#PBS -N hcotqa2
#PBS -q gpu
#PBS -l nodes=node22:ppn=4:gpus=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_solar_geometry_repair_20261021/history_cot_forecast_ghi_20261022/history_bank_audit_attempt2.log
set -euo pipefail

BASE=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_solar_geometry_repair_20261021
OUT=$BASE/history_cot_forecast_ghi_20261022
PACK=$BASE/GHI_pack_attempt12
DATA=$BASE/prepared_attempt12
CODE=$BASE/code_pipeline_attempt12
R_CKPT=$BASE/R_runs_attempt12/full/best.pt
R_NORM=$DATA/R_packs/full/norm.json
R_SOURCE=$CODE/train_cot_repaired.py
PY=/public/home/slfu/miniconda3/envs/swc/bin/python
BANK=$OUT/history_bank_attempt1
QSTAT=/opt/gridview/pbs/dispatcher/bin/qstat

fail_record() {
  rc=$?
  printf '{"state":"FAILED","job_id":"%s","exit_code":%s,"host":"%s"}\n' \
    "${PBS_JOBID:-unknown}" "$rc" "$(hostname)" > "$OUT/bank_audit_attempt2_failure.json"
  exit "$rc"
}
trap fail_record ERR

GPU_TEXT=$($QSTAT -f "$PBS_JOBID" | grep -oE 'node22-gpu/[0-9]+' | cut -d/ -f2 | sort -un | paste -sd, -)
if [[ "$(printf '%s\n' "$GPU_TEXT" | sed '/^$/d' | wc -l)" -ne 1 ]]; then
  echo "Expected one allocated node22 GPU, got: $GPU_TEXT" >&2
  exit 2
fi
export CUDA_VISIBLE_DEVICES="$GPU_TEXT"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONUNBUFFERED=1
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"

echo "HISTORY_COT_BANK_AUDIT_ATTEMPT2_START job=$PBS_JOBID host=$(hostname) gpu=node22-gpu/$GPU_TEXT"
nvidia-smi -i "$GPU_TEXT" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
test -d /dev/shm/hubei_solar_corrected_20261021_attempt10/data
test -d /dev/shm/hubei_solar_corrected_20261021_attempt10/aux
test -f "$DATA/stage_manifest.csv"
test -f "$PACK/rows.csv"
test -f "$BANK/bank_report.json"
test ! -e "$BANK/bank_audit.json"
"$PY" "$OUT/audit_history_cot_bank.py" \
  --bank "$BANK" --stage-manifest "$DATA/stage_manifest.csv" --ghi-rows "$PACK/rows.csv" \
  --checkpoint "$R_CKPT" --normalization "$R_NORM" --model-source "$R_SOURCE" \
  --output "$BANK/bank_audit.json"
printf '{"state":"PASS_HISTORY_COT_BANK_INDEPENDENT_AUDIT","job_id":"%s","gpu":"%s","test_payloads_read":0,"buffer_payloads_read":0}\n' \
  "$PBS_JOBID" "$GPU_TEXT" > "$OUT/bank_audit_attempt2_complete.json"
echo "HISTORY_COT_BANK_AUDIT_PASS job=$PBS_JOBID"
