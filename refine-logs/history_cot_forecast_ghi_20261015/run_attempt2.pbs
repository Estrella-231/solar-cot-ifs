#!/bin/bash
#PBS -N histcot_ghi_pair
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/history_cot_forecast_ghi_20261015_v1/pbs_attempt2.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test "$(echo "$GPU" | wc -l)" -eq 1
test -z "$(nvidia-smi -i "$GPU" --query-compute-apps=pid --format=csv,noheader)"
export CUDA_VISIBLE_DEVICES="$GPU"

SOLAR=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$SOLAR/experiments/history_cot_forecast_ghi_20261015_v1
BANK=$SOLAR/experiments/regional_station_cot_20260925
nvidia-smi -i "$GPU" --query-gpu=index,name,memory.total,memory.used --format=csv > "$EXP/allocation_attempt2.csv"
export PYTHONPATH="$SOLAR/scripts:${PYTHONPATH:-}"
python -m py_compile "$SOLAR/scripts/train_history_cot_ghi_paired_20261015.py"
python -u "$SOLAR/scripts/train_history_cot_ghi_paired_20261015.py" \
 --cot-bank "$BANK/sili_cot_dynamics_bank_train512_val512_20260927_v1" \
 --train-images "$BANK/regional_ghi_pilot_bank_20260927_v1" \
 --val-images "$BANK/regional_ghi_pilot_bank_val512_20260927_v1" \
 --cot-run "$BANK/sili_full_vs_repeat_last_seed42_20260928_v5/full_history" \
 --base "$SOLAR/data/head_pack_trainval_20260908_v1" \
 --day-assignment "$EXP/day_assignment.csv" \
 --output "$EXP/results_attempt2" --updates 1200
