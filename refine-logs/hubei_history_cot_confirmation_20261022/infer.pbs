#!/bin/bash
#PBS -N cotnewperiod
#PBS -q gpu
#PBS -l nodes=node23:ppn=24:gpus=4
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_history_cot_confirmation_20261022/infer_attempt1.log
set -euo pipefail
EXP=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_history_cot_confirmation_20261022
PY=/public/home/slfu/miniconda3/envs/swc/bin/python
test -f "$EXP/TRANSFER_REPORT.json"
GPU_TEXT=$(qstat -f "$PBS_JOBID" | grep -oE 'node23-gpu/[0-9]+' | cut -d/ -f2 | sort -un | paste -sd, -)
IFS=, read -r -a GPU_IDS <<< "$GPU_TEXT"
test "${#GPU_IDS[@]}" -eq 4
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
nvidia-smi -i "$GPU_TEXT" --query-gpu=index,uuid,name,memory.used,memory.total,utilization.gpu --format=csv > "$EXP/resource_attempt1.txt"
export CUDA_VISIBLE_DEVICES="${GPU_IDS[0]}"
"$PY" "$EXP/code_attempt1/replay_heads.py"
LOCAL=/dev/shm/hubei_cot_confirmation_${PBS_JOBID%%.*}
test ! -e "$LOCAL"
mkdir "$LOCAL"
cp -a "$EXP/stage_attempt2/data" "$EXP/stage_attempt2/aux" "$LOCAL/"
export CUDA_VISIBLE_DEVICES="$GPU_TEXT"
"$PY" "$EXP/code_attempt1/run_inference.py" --gpus "$GPU_TEXT" --data "$LOCAL" --root "$EXP"
"$PY" "$EXP/code_attempt1/score_new_period.py" --predictions "$EXP/predictions_attempt1" --out "$EXP/scored_attempt1"
echo "NEW_PERIOD_PAIRED_INFERENCE_COMPLETE job=$PBS_JOBID gpus=$GPU_TEXT"
