#!/bin/bash
#PBS -N dy_fast_resume
#PBS -q gpu
#PBS -l nodes=node21:ppn=24:gpus=4
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/refine-logs/fulltrain_forecast_cot_20261101/fast_pbs.log
set -euo pipefail
B=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/refine-logs/fulltrain_forecast_cot_20261101
P=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
OLD=$P/refine-logs/cot_aware_simvp_20261017
cd "$B"
exec > >(tee -a "$B/fast_execution.log") 2>&1
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
GPUS=$(qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'node21-gpu/[0-9]+' | cut -d/ -f2 | sort -un | paste -sd,)
IFS=, read -ra GA <<< "$GPUS"
[ "${#GA[@]}" -eq 4 ] || exit 32
export ASSIGNED_GPUS="$GPUS"
nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv
ARGS=(--simvp-root "$P/experiments/hunan_monthly_block_20261002" --r-root "$P/experiments/monthly_R_station16_20261013_v1" --data-root /public/home/slfu/ttzhou/Auxiliary_data/HuNan_AGRI_Preprocessed --crosswalk "$P/experiments/monthly_R_station16_20261013_v1/input/target_candidates_train_val.csv" --keys "$OLD/results/future_ghi_crosswalk_keys.npz" --frame-cache "$B/unused_cache" --batch-sequences 2 --r-batch-patches 128)
test -f "$B/smoke/bank_manifest.json"
pids=()
for rank in 0 1 2 3; do
 CUDA_VISIBLE_DEVICES=${GA[$rank]} python -u build_bank_fast.py "${ARGS[@]}" --resume --output "$B/bank_rank$rank" --rank "$rank" --world 4 > "$B/bank_rank${rank}_fast.log" 2>&1 &
 pids+=($!)
done
for pid in "${pids[@]}"; do wait "$pid"; done
python -u finish_pipeline.py
echo FULLTRAIN_DYDIFF_GHI_COMPLETE
