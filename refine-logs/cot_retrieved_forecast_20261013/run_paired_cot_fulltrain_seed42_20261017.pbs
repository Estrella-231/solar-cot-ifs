#!/bin/bash
#PBS -N cot_full42_17
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/refine-logs/cot_retrieved_forecast_20261013/logs/paired_fulltrain_seed42_b1024_e12_20261017.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
BRANCH=$ROOT/refine-logs/cot_retrieved_forecast_20261013
BANK=$ROOT/experiments/monthly_R_station16_20261013_v1/results/new_monthly_R_seed42_cot_bank_v1
PACK=$BRANCH/data/sequence_cpp_pack_20261017
OUT=$BRANCH/results/fulltrain_20261017_seed42_b1024_e12
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU" && test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
test ! -e "$OUT"
python -u "$BRANCH/train_retrieved_cot_forecaster_20261017.py" \
  --branch "$BRANCH" --bank "$BANK" --pack "$PACK" --output "$OUT" \
  --seed 42 --width 96 --batch-size 1024 --workers 8 --epochs 12 --max-train-sequences 28806
echo PAIRED_COT_FULLTRAIN_COMPLETE
