#!/bin/bash
#PBS -N cot_load_prof17
#PBS -q gpu
#PBS -l nodes=node22:ppn=8
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/refine-logs/cot_retrieved_forecast_20261013/logs/loader_profile_20261017.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
BRANCH=$ROOT/refine-logs/cot_retrieved_forecast_20261013
BANK=$ROOT/experiments/monthly_R_station16_20261013_v1/results/new_monthly_R_seed42_cot_bank_v1
PACK=$BRANCH/data/sequence_cpp_pack_20261017
python -u "$BRANCH/profile_retrieved_cot_loader_20261017.py" \
  --branch "$BRANCH" --bank "$BANK" --pack "$PACK" \
  --output "$BRANCH/results/profile_20261017/loader_profile.json" --workers 8
echo REAL_TRAIN_LOADER_GPU_PROFILE_COMPLETE
