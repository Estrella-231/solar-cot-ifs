#!/bin/bash
#PBS -N hb_oof_cot15
#PBS -q gpu
#PBS -l nodes=node22:ppn=24:gpus=4
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_cot_station_patch_forecast_20261022/oof_source_cv_attempt15/pbs.log
set -euo pipefail

PROJECT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
BASE=$PROJECT/experiments/hubei_cot_station_patch_forecast_20261022
ATTEMPT=$BASE/oof_source_cv_attempt15
CACHE_BUILD=$ATTEMPT/cache_build_v1
TRAINER=$ATTEMPT/scripts/train_station_patch_cot_forecaster.py
PY=/public/home/slfu/miniconda3/envs/swc/bin/python
RUNROOT=$ATTEMPT/training
LOGROOT=$ATTEMPT/logs

mkdir -p "$ATTEMPT" "$LOGROOT"
trap 'status=$?; echo OOF15_ERR line=$LINENO command=$BASH_COMMAND status=$status; exit $status' ERR
echo "OOF_SOURCE_CV_ATTEMPT15_START job=$PBS_JOBID host=$(hostname)"

test -f "$CACHE_BUILD/BUILD_MANIFEST.json"
test -f "$CACHE_BUILD/CACHE_AUDIT.json"
test -f "$TRAINER"
test -f "$PROJECT/scripts/retrieved_cot_forecaster_20261013.py"
test ! -e "$ATTEMPT/pair_complete.json"
test ! -e "$RUNROOT"

"$PY" - "$CACHE_BUILD/BUILD_MANIFEST.json" "$CACHE_BUILD/CACHE_AUDIT.json" <<'PY'
import json, sys
build, audit = [json.load(open(p, encoding="utf-8")) for p in sys.argv[1:]]
assert build["state"] == "COMPLETE_OOF_SOURCE_PAIRED_CACHE_BUILD", build
assert audit["state"] == "PASS_STATION_PATCH_CACHE_AND_PAIR_AUDIT_TEST_BUFFER_CLOSED", audit
for doc in (build, audit):
    assert doc.get("test_payloads_read") == 0 and doc.get("buffer_payloads_read") == 0, doc
    assert doc.get("official_monthly_validation_payloads_read", 0) == 0, doc
print("CACHE_BUILD_AND_PAIR_AUDIT_PASS; monthly validation/test/buffer closed")
PY

source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONPATH="$ATTEMPT/scripts:$PROJECT/scripts${PYTHONPATH:+:$PYTHONPATH}"
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"

GPU_TEXT=$(qstat -f "$PBS_JOBID" | grep -oE 'node22-gpu/[0-9]+' | sort -Vu | cut -d/ -f2)
mapfile -t GPU_IDS <<< "$GPU_TEXT"
test "${#GPU_IDS[@]}" -eq 4
printf 'ALLOCATED_NODE22_GPU_IDS=%s\n' "${GPU_IDS[*]}"
nvidia-smi -i "$(IFS=,; echo "${GPU_IDS[*]}")" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
for gpu in "${GPU_IDS[@]}"; do
  test -z "$(nvidia-smi -i "$gpu" --query-compute-apps=pid --format=csv,noheader)"
done

# Copy the already audited cache once to node-local storage; all paired fits
# then reuse it without repeatedly streaming arrays from the shared filesystem.
LOCAL_ROOT="/tmp/oof_source_cv_attempt15_${PBS_JOBID}"
LOCAL_CACHE_ROOT="$LOCAL_ROOT/cache_build_v1"
mkdir -p "$LOCAL_ROOT"
cp -a "$CACHE_BUILD" "$LOCAL_CACHE_ROOT"
test -f "$LOCAL_CACHE_ROOT/CACHE_AUDIT.json"
sha256sum "$LOCAL_CACHE_ROOT"/fullr_control/cache/*npy "$LOCAL_CACHE_ROOT"/oof_train_source/cache/*npy > "$LOGROOT/local_cache_sha256_${PBS_JOBID}.txt"

run_one() {
  local gpu="$1" arm="$2" seed="$3" out cache
  out="$RUNROOT/${arm}_seed${seed}"
  cache="$LOCAL_CACHE_ROOT/$arm/cache"
  test ! -e "$out"
  mkdir -p "$out"
  (
    export CUDA_VISIBLE_DEVICES="$gpu"
    "$PY" "$TRAINER" --mode train --cache "$cache" --output "$out" \
      --global-batch 32 --seed "$seed" --width 96 --lr 1e-4 --min-lr 1e-6 \
      --weight-decay 1e-4 --max-epochs 10 --patience 11 --min-delta 1e-3 \
      --loader-workers 0 > "$LOGROOT/${arm}_seed${seed}.log" 2>&1
    test -f "$out/training_complete.json"
    test -f "$out/best.pt"
    test -f "$out/last.pt"
    test -f "$out/outer_train_holdout_predictions.npz"
    "$PY" - "$out/training_complete.json" "$seed" <<'PY'
import json, sys
d=json.load(open(sys.argv[1], encoding="utf-8"))
assert d["seed"] == int(sys.argv[2]), d
assert d["global_batch"] == 32 and d["world_size"] == 1, d
assert d["train_config"]["max_epochs"] == 10 and d["train_config"]["patience"] == 11, d
assert d["global_step"] > 0, d
assert d["test_payloads_read"] == 0 and d["buffer_payloads_read"] == 0, d
PY
    sha256sum "$out/best.pt" "$out/last.pt" \
      "$out/outer_train_holdout_predictions.npz" "$out/training_complete.json" > "$out/SHA256SUMS"
    echo "OOF15_RUN_COMPLETE arm=$arm seed=$seed gpu=$gpu"
  )
}

wait_all() {
  local rc=0 pid
  for pid in "$@"; do
    wait "$pid" || rc=1
  done
  return "$rc"
}

mkdir -p "$RUNROOT"
# Pair seeds 42/43 across arms in wave 1, then seed 44 across two GPUs.
run_one "${GPU_IDS[0]}" fullr_control 42 & p1=$!
run_one "${GPU_IDS[1]}" oof_train_source 42 & p2=$!
run_one "${GPU_IDS[2]}" fullr_control 43 & p3=$!
run_one "${GPU_IDS[3]}" oof_train_source 43 & p4=$!
wait_all "$p1" "$p2" "$p3" "$p4"

run_one "${GPU_IDS[0]}" fullr_control 44 & p5=$!
run_one "${GPU_IDS[1]}" oof_train_source 44 & p6=$!
wait_all "$p5" "$p6"

sha256sum "$RUNROOT"/*/best.pt "$RUNROOT"/*/last.pt \
  "$RUNROOT"/*/outer_train_holdout_predictions.npz \
  "$RUNROOT"/*/training_complete.json > "$ATTEMPT/TRAINING_SHA256SUMS.txt"
"$PY" - "$ATTEMPT" "$PBS_JOBID" "${GPU_IDS[*]}" <<'PY'
import glob, json, os, sys
root, job, gpu_ids = sys.argv[1:]
runs = glob.glob(os.path.join(root, "training", "*_seed*"))
assert len(runs) == 6, runs
expected = {"fullr_control_seed42", "fullr_control_seed43", "fullr_control_seed44",
            "oof_train_source_seed42", "oof_train_source_seed43", "oof_train_source_seed44"}
assert {os.path.basename(p) for p in runs} == expected, runs
records = [json.load(open(os.path.join(p, "training_complete.json"), encoding="utf-8")) for p in runs]
steps = {r["global_step"] for r in records}
assert len(steps) == 1, steps
for r in records:
    assert r["global_batch"] == 32 and r["world_size"] == 1
    assert r["train_config"]["max_epochs"] == 10 and r["train_config"]["patience"] == 11
    assert r["test_payloads_read"] == 0 and r["buffer_payloads_read"] == 0
receipt = {"state":"COMPLETE_OOF_SOURCE_CV_TRAINING", "job_id":job,
           "node":os.uname().nodename, "allocated_gpu_ids":gpu_ids,
           "models_completed":6, "optimizer_steps_per_model":next(iter(steps)),
           "global_batch":32, "max_epochs":10, "test_payloads_read":0,
           "buffer_payloads_read":0, "official_monthly_validation_payloads_read":0}
open(os.path.join(root,"pair_complete.json"),"w",encoding="utf-8").write(json.dumps(receipt,indent=2)+"\n")
print(json.dumps(receipt,indent=2))
PY
echo "OOF_SOURCE_CV_ATTEMPT15_COMPLETE job=$PBS_JOBID gpu_ids=${GPU_IDS[*]}"
