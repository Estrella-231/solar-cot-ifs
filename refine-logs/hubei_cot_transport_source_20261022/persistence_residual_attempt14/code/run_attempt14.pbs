#!/bin/bash
#PBS -N hb_cot_loss14
#PBS -q gpu
#PBS -l nodes=node22:ppn=24:gpus=3
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_cot_station_patch_forecast_20261022/persistence_residual_attempt14/pbs.log
set -euo pipefail

PROJECT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
BASE=$PROJECT/experiments/hubei_cot_station_patch_forecast_20261022
CODE=$BASE/cache_attempt6
NEWCODE=$BASE/persistence_residual_attempt14/code
ATTEMPT=$BASE/persistence_residual_attempt14
SHARED_CACHE=$BASE/cache_attempt5/cache
AUDIT=$BASE/cache_attempt5/cache_audit/cache_audit.json
PROFILE=$BASE/gpu_training_attempt8/profile_v8
ATTEMPT13=$BASE/persistence_residual_attempt13/train_seed42
RUNROOT=$ATTEMPT/runs
PY=/public/home/slfu/miniconda3/envs/swc/bin/python

mkdir -p "$ATTEMPT" "$RUNROOT"
exec > >(tee -a "$ATTEMPT/pbs.log") 2>&1
echo "PERSISTENCE_RESIDUAL_ATTEMPT14_START job=$PBS_JOBID host=$(hostname)"
set -x
trap 'status=$?; echo ATTEMPT14_ERR line=$LINENO command=$BASH_COMMAND status=$status; exit $status' ERR

test -f "$CODE/train_station_patch_cot_forecaster.py"
test -f "$PROJECT/scripts/retrieved_cot_forecaster_20261013.py"
test -f "$SHARED_CACHE/cache_report.json"
test -f "$AUDIT"
test -f "$PROFILE/profile_1gpu.json"
test -f "$PROFILE/profile_2gpu.json"
test -f "$PROFILE/profile_4gpu.json"
test -f "$NEWCODE/run_train_candidate.py"
test -f "$NEWCODE/run_train_hybrid_loss.py"
test -f "$NEWCODE/hybrid_physical_loss_20261022.py"
test -f "$NEWCODE/persistence_residual_cot_forecaster_20261022.py"
test -f "$ATTEMPT13/best.pt"
test -f "$ATTEMPT13/validation_forecast_predictions.npz"
test ! -f "$ATTEMPT/pair_complete.json"
test ! -f "$ATTEMPT/runs/hybrid_seed42/training_complete.json"
test ! -f "$ATTEMPT/runs/log_only_seed43/training_complete.json"
test ! -f "$ATTEMPT/runs/hybrid_seed43/training_complete.json"
test ! -f "$ATTEMPT/runs/log_only_seed44/training_complete.json"
test ! -f "$ATTEMPT/runs/hybrid_seed44/training_complete.json"

"$PY" - "$AUDIT" "$PROFILE" "$CODE/train_station_patch_cot_forecaster.py" "$SHARED_CACHE/cache_report.json" <<'PY'
import hashlib, json, sys
audit=json.load(open(sys.argv[1]))
profiles=[json.load(open(f"{sys.argv[2]}/profile_{n}gpu.json")) for n in (1,2,4)]
code_hash=hashlib.sha256(open(sys.argv[3],'rb').read()).hexdigest()
cache_report_hash=hashlib.sha256(open(sys.argv[4],'rb').read()).hexdigest()
assert audit.get('state') == 'PASS_STATION_PATCH_CACHE_AND_PAIR_AUDIT_TEST_BUFFER_CLOSED', audit
assert audit.get('test_payloads_read') == 0 and audit.get('buffer_payloads_read') == 0, audit
assert audit.get('trainval_rows') == 22061, audit
assert [p.get('global_batch') for p in profiles] == [32,32,32], profiles
assert profiles[0]['global_samples_per_second'] > profiles[1]['global_samples_per_second'] > profiles[2]['global_samples_per_second'], profiles
assert code_hash == '1dfca810a965aa0d3f679923c7bdf56d6d94de004d328a46ec61a21646f8529a', code_hash
assert cache_report_hash == 'b5f55d09beb7cac4d4484d4d38c1af90357230d3584cbc4158790166c2aa1c75', cache_report_hash
print('ATTEMPT14_TRAINVAL_CACHE_PROFILE_AND_BASE_TRAINER_HASH_PASS')
PY

source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONPATH="$NEWCODE:$CODE:$PROJECT/scripts${PYTHONPATH:+:$PYTHONPATH}"
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"

GPU_TEXT=$(qstat -f "$PBS_JOBID" | grep -oE 'node22-gpu/[0-9]+' | sort -Vu | cut -d/ -f2)
mapfile -t GPU_IDS <<< "$GPU_TEXT"
test "${#GPU_IDS[@]}" -eq 3
printf 'ALLOCATED_NODE22_GPU_IDS=%s\n' "${GPU_IDS[*]}"
nvidia-smi -i "$(IFS=,; echo "${GPU_IDS[*]}")" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
for gpu in "${GPU_IDS[@]}"; do
  test -z "$(nvidia-smi -i "$gpu" --query-compute-apps=pid --format=csv,noheader)"
done

LOCAL_ROOT="/tmp/cot_loss_alignment_${PBS_JOBID}"
LOCAL_CACHE=$LOCAL_ROOT/cache
mkdir -p "$LOCAL_CACHE" "$LOCAL_ROOT/cache_audit"
cp -a "$SHARED_CACHE"/. "$LOCAL_CACHE"/
cp "$AUDIT" "$LOCAL_ROOT/cache_audit/cache_audit.json"
test -f "$LOCAL_CACHE/cache_report.json"

run_one() {
  local gpu="$1" arm="$2" seed="$3" out runner
  out="$RUNROOT/${arm}_seed${seed}"
  mkdir -p "$out"
  if [[ "$arm" == "log_only" ]]; then
    runner="$NEWCODE/run_train_candidate.py"
  elif [[ "$arm" == "hybrid" ]]; then
    runner="$NEWCODE/run_train_hybrid_loss.py"
  else
    echo "unknown arm: $arm" >&2
    return 2
  fi
  (
    export CUDA_VISIBLE_DEVICES="$gpu"
    "$PY" "$runner" "$CODE/train_station_patch_cot_forecaster.py" \
      --mode train --cache "$LOCAL_CACHE" --output "$out" \
      --global-batch 32 --seed "$seed" --width 96 --lr 1e-4 --min-lr 1e-6 \
      --weight-decay 1e-4 --max-epochs 10 --patience 8 --min-delta 1e-3 \
      --loader-workers 0 > "$out/train.log" 2>&1
    test -f "$out/training_complete.json"
    test -f "$out/best.pt"
    test -f "$out/validation_forecast_predictions.npz"
    "$PY" "$CODE/evaluate_station_patch_cot_validation.py" \
      --cache "$LOCAL_CACHE" --predictions "$out/validation_forecast_predictions.npz" \
      --output "$out/validation_score.json" --bootstrap 5000 --seed 42
    sha256sum "$out/best.pt" "$out/last.pt" \
      "$out/validation_forecast_predictions.npz" "$out/validation_score.json" \
      "$out/training_complete.json" > "$out/SHA256SUMS"
    echo "ATTEMPT14_RUN_COMPLETE arm=$arm seed=$seed gpu=$gpu"
  )
}

# Three independent single-GPU fits at a time; no DDP changes the loss contract.
run_one "${GPU_IDS[0]}" hybrid 42 & p1=$!
run_one "${GPU_IDS[1]}" log_only 43 & p2=$!
run_one "${GPU_IDS[2]}" hybrid 43 & p3=$!
wait "$p1"
wait "$p2"
wait "$p3"

run_one "${GPU_IDS[0]}" log_only 44 & p4=$!
run_one "${GPU_IDS[1]}" hybrid 44 & p5=$!
wait "$p4"
wait "$p5"

sha256sum "$ATTEMPT"/runs/*/best.pt "$ATTEMPT"/runs/*/last.pt \
  "$ATTEMPT"/runs/*/validation_forecast_predictions.npz \
  "$ATTEMPT"/runs/*/validation_score.json \
  "$ATTEMPT"/runs/*/training_complete.json > "$ATTEMPT/SHA256SUMS"
printf '{"state":"COMPLETE_ATTEMPT14_TRAINING","job_id":"%s","gpu_ids":"%s","global_batch":32,"test_payloads_read":0,"buffer_payloads_read":0}\n' \
  "$PBS_JOBID" "${GPU_IDS[*]}" > "$ATTEMPT/pair_complete.json"
echo "PERSISTENCE_RESIDUAL_ATTEMPT14_COMPLETE job=$PBS_JOBID gpu_ids=${GPU_IDS[*]}"
