#!/bin/bash
#PBS -N rregionprof
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=4
#PBS -l walltime=00:40:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_cot_regional_input_20261023/profile_attempt1.log
set -euo pipefail
BASE=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_cot_regional_input_20261023
PACK=/dev/shm/hubei_regional_r_pack_20261023_attempt2
export CUDA_VISIBLE_DEVICES=$(qstat -f "$PBS_JOBID" | grep -oE 'node22-gpu/[0-9]+' | cut -d/ -f2 | sort -un | paste -sd, -)
test "$(echo "$CUDA_VISIBLE_DEVICES" | tr ',' '\n' | wc -l)" -eq 4
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
CUDNN_LIB=$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib
export LD_PRELOAD="$CUDNN_LIB/libcudnn_ops_infer.so.8:$CUDNN_LIB/libcudnn_ops_train.so.8:$CUDNN_LIB/libcudnn_cnn_infer.so.8:$CUDNN_LIB/libcudnn_cnn_train.so.8:$CUDNN_LIB/libcudnn_adv_infer.so.8:$CUDNN_LIB/libcudnn_adv_train.so.8:$CUDNN_LIB/libcudnn.so.8"
python "$BASE/check_allocated_gpus.py"
for N in 2 4; do
    python -m torch.distributed.run --standalone --nnodes=1 --nproc_per_node="$N" "$BASE/train_regional_r.py" --pack "$PACK" --roles "$BASE/R_INTERNAL_ROLES.json" --out "$BASE/witness${N}_attempt1" --witness-only
done
python "$BASE/compare_gpu_witnesses.py" --two "$BASE/witness2_attempt1" --four "$BASE/witness4_attempt1" --out "$BASE/GPU_EQUIVALENCE_attempt1.json"
for N in 2 4; do
    python -m torch.distributed.run --standalone --nnodes=1 --nproc_per_node="$N" "$BASE/train_regional_r.py" --pack "$PACK" --roles "$BASE/R_INTERNAL_ROLES.json" --out "$BASE/profile${N}_attempt1" --profile-only
done
python "$BASE/select_profile.py" --root "$BASE" --out "$BASE/PROFILE_DECISION_attempt1.json"
