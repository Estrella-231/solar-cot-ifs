 --root /public/home/slfu/ttzhou/Auxiliary_data/HuNan_AGRI_Preprocessed/data \
 --manifests /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hunan_monthly_block_20261002/manifests_v1 \
 --grid grid_static_hunan.npz --output READINESS_CPU.json
