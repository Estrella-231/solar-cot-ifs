#!/usr/bin/env bash
#PBS -N hn150_cot_ghi4
#PBS -q gpu
#PBS -l nodes=node21:ppn=24:gpus=4
#PBS -l walltime=24:00:00
#PBS -j oe
set -eo pipefail
export LC_ALL=C LANG=C PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-}"
BASE=/public/home/slfu/ttzhou/swc/irradiance_forecast/HunanDyDiff_20261028
TASK="$BASE/hunan_full_validation_20261030"
cd "$TASK"
exec > "$TASK/launch_${PBS_JOBID}.log" 2>&1
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 EXPECTED_GPUS=4
export CUDA_VISIBLE_DEVICES=$(python "$BASE/code_hunan_v1/allocated_gpus.py")
export HUNAN_DY_CACHE=/tmp/slfu_hunan_dydiff_20261028_v1
echo "HUNAN_EPOCH150_COT_GHI_START job=$PBS_JOBID host=$(hostname) gpus=$CUDA_VISIBLE_DEVICES"
nvidia-smi --id="$CUDA_VISIBLE_DEVICES" --query-gpu=index,name,memory.used,memory.total --format=csv
# Only the backbone adapter changes. Reuse the already verified R/GHI GPU path.
python -u -m torch.distributed.run --standalone --nproc_per_node=4 generate_hunan.py --indices-file "$BASE/cross_hubei_on_hunan_20261028/attempt1/selection.json" --output "$TASK/forecast_smoke1" > "smoke_generate_${PBS_JOBID}.log" 2>&1
python -u evaluate_full_gpu.py --smoke --prediction-root "$TASK/forecast_smoke1" --output "$TASK/evaluation_smoke1" > "smoke_evaluate_${PBS_JOBID}.log" 2>&1
echo HUNAN_PIPELINE_SMOKE_PASS
python -u -m torch.distributed.run --standalone --nproc_per_node=4 generate_hunan.py --output "$TASK/forecast_attempt1" > "generate_${PBS_JOBID}.log" 2>&1
mkdir -p "$TASK/evaluation_shards1"
pids=()
for rank in 0 1 2 3; do
 python -u evaluate_full_gpu.py --prediction-root "$TASK/forecast_attempt1" --rank "$rank" --world 4 --output "$TASK/evaluation_shards1/rank$rank" > "evaluate_rank${rank}_${PBS_JOBID}.log" 2>&1 &
 pids+=("$!")
done
failed=0
for pid in "${pids[@]}"; do wait "$pid" || failed=1; done
test "$failed" = 0
python merge_shards.py "$TASK" 4 > "merge_${PBS_JOBID}.log"
python score_full.py "$TASK/evaluation_attempt1" > "score_${PBS_JOBID}.log"
echo HUNAN_EPOCH150_COT_GHI_ALL_COMPLETE
