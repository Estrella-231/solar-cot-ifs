#!/bin/bash
#PBS -N hb_fc_BJTfix
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_forecast_correctutc_20261020/time_repair_v1/run_attempt1.log
set -euo pipefail
PROJECT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
BASE=$PROJECT/experiments/hubei_forecast_correctutc_20261020
EXP=$BASE/time_repair_v1/runtime_attempt1
CODE=$BASE/time_repair_v1/code_attempt1
OLD=/public/home/slfu/ttzhou/swc/irradiance_forecast/hubei_forecast_ghi_20261017/pack
CURRENT=$PROJECT/experiments/hubei_cloud_probability_20261020
GPU_TEXT=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'node22-gpu/[0-9]+' | cut -d/ -f2 | sort -un)
if [ -z "$GPU_TEXT" ] || [ "$(printf '%s\n' "$GPU_TEXT" | wc -l)" -ne 1 ]; then echo 'GPU_ASSIGNMENT_FAIL'; exit 32; fi
export CUDA_VISIBLE_DEVICES="$GPU_TEXT"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_adv_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
echo "START PBS=$PBS_JOBID NODE=$(hostname) GPU=$GPU_TEXT"
nvidia-smi -i "$GPU_TEXT" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
test -z "$(nvidia-smi -i "$GPU_TEXT" --query-compute-apps=pid --format=csv,noheader)"
LOCAL=/tmp/hb_fc_BJTfix_${PBS_JOBID//./_}
mkdir "$LOCAL" "$EXP"
cp -a "$CODE" "$LOCAL/code"
CODE=$LOCAL/code
(cd "$CODE" && sha256sum -c SHA256SUMS)
python "$CODE/witness_pair.py"
python -c 'import torch;torch.manual_seed(42);m=torch.nn.Conv2d(16,32,3,padding=1).cuda();x=torch.randn(8,16,16,16,device="cuda");y=m(x).square().mean();y.backward();assert torch.isfinite(y) and torch.isfinite(m.weight.grad).all();print("GPU_FORWARD_BACKWARD_PASS",torch.cuda.get_device_name(0))'
cp "$BASE/input_attempt1/frozen_forecast_inputs.tar" "$LOCAL/"
cp "$BASE/time_repair_v1/time_lineage_v2.tar.gz" "$LOCAL/"
python - "$LOCAL" "$BASE" <<'PY'
import sys,hashlib,tarfile
from pathlib import Path
l,b=map(Path,sys.argv[1:])
def digest(p):
 h=hashlib.sha256()
 with p.open('rb') as f:
  for x in iter(lambda:f.read(8<<20),b''):h.update(x)
 return h.hexdigest()
for archive,receipt,dest in [('frozen_forecast_inputs.tar',b/'input_attempt1/archive_sha256.txt','inputs'),('time_lineage_v2.tar.gz',b/'time_repair_v1/metadata_archive_sha256.txt','metadata')]:
 p=l/archive;assert digest(p)==receipt.read_text(encoding='utf-8-sig').split()[0]
 with tarfile.open(p) as t:
  members=t.getmembers();assert all(m.isfile() and not Path(m.name).is_absolute() and '..' not in Path(m.name).parts for m in members)
  t.extractall(l/dest)
print('LOCAL_ARCHIVES_HASH_PASS',flush=True)
PY
CURRENT=$PROJECT/experiments/hubei_cloud_probability_20261020
cp -a "$CURRENT/R_pack_correctutc_attempt2" "$LOCAL/full_R_pack"
python -u "$CODE/rebuild_aligned_pack.py" "$BASE" "$LOCAL" "$LOCAL/pack"
cp -a "$LOCAL/pack" "$EXP/pack"
python -u "$CODE/train_paired_forecast.py" --pack "$LOCAL/pack" --output "$EXP/profile_placeholder" --input-mode forecast --arms FA FAC --profile-only --profile-output "$EXP/profile.json"
mkdir "$LOCAL/results"
for seed in 42 43 44; do
  python -u "$CODE/train_paired_forecast.py" --pack "$LOCAL/pack" --output "$LOCAL/results/paired_seed${seed}_attempt1" --input-mode forecast --arms FA FAC --epochs 30 --batch-size 1536 --seed "$seed"
  cp -a "$LOCAL/results/paired_seed${seed}_attempt1" "$EXP/paired_seed${seed}_attempt1"
done
python -u "$CODE/score_predictions.py" --experiment "$LOCAL/results" --pack "$LOCAL/pack" --output "$LOCAL/scored"
cp -a "$LOCAL/scored" "$EXP/scored"
mkdir "$LOCAL/R_assets"
cp -a "$LOCAL/full_R_pack" "$LOCAL/R_assets/R_pack_correctutc_attempt2"
cp -a "$CURRENT/R_correctutc_attempt3" "$LOCAL/R_assets/R_correctutc_attempt3"
cp "$BASE/diagnosis_v1/forecast/validation/true_agri_patch.npy" "$LOCAL/inputs/forecast/validation/"
python -u "$CODE/fixed_head_diagnosis.py" "$BASE" "$LOCAL"
cp -a "$LOCAL/fixed_head_diagnosis" "$EXP/fixed_head_diagnosis"
echo 'BJT_TIME_REPAIR_PAIRED_AND_DIAGNOSIS_COMPLETE test_payloads_read=0 buffer_payloads_read=0'
