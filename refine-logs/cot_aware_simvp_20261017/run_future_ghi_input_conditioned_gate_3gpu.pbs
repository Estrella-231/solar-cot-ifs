#!/bin/bash
#PBS -N fghi_cot_gate3
#PBS -q gpu
#PBS -l nodes=node22:ppn=16:gpus=3
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /dev/null
set -euo pipefail
PROJECT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$PROJECT/refine-logs/cot_aware_simvp_20261017
PACK=$EXP/results/future_ghi_oof_head_pack_v2
CAL=$EXP/results/future_cot_oof_reliability_v2/calibration.json
BASE=$EXP/results/future_ghi_oof_cot_reliability_v1
RUN=$EXP/results/future_ghi_input_conditioned_gate_v1
AUDIT=$EXP/results/future_ghi_input_conditioned_gate_audit_v1.json
LOG=$EXP/logs/future_ghi_input_conditioned_gate_3gpu_${PBS_JOBID}.log
mkdir -p "$EXP/logs"
exec > >(tee -a "$LOG") 2>&1
cd "$EXP"
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONPYCACHEPREFIX=/tmp/slfu_fghi_gate_pycache
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
python -m py_compile train_future_ghi_input_conditioned_gate.py test_future_ghi_input_conditioned_gate.py audit_future_ghi_spatial_contrast.py
python test_future_ghi_input_conditioned_gate.py
python - "$PACK/pack_manifest.json" "$CAL" "$BASE" <<'PY'
import csv,json,hashlib,sys
from pathlib import Path
def sha(p):
 h=hashlib.sha256()
 with open(p,'rb') as f:
  for b in iter(lambda:f.read(1<<20),b''):h.update(b)
 return h.hexdigest()
pack=Path(sys.argv[1]).parent; manifest=json.load(open(sys.argv[1])); cal=json.load(open(sys.argv[2])); base=Path(sys.argv[3])
assert manifest['state']=='COMPLETE_CAUSAL_FUTURE_GHI_HEAD_PACK' and manifest['train_forecast_oof'] is True and manifest['forecast_bank_oof_fold_count']==5
assert manifest['test_payload_opened'] is False and manifest['buffer_payload_opened'] is False and manifest['future_observed_agri_used_as_input'] is False and manifest['cpp_used_as_input'] is False
assert cal['state']=='COMPLETE_CROSSFIT_TRAIN_ONLY_OOF_FUTURE_COT_RELIABILITY_CALIBRATION' and cal['forecast_pack_manifest_sha256']==sha(sys.argv[1])
assert cal['test_payload_opened'] is False and cal['buffer_payload_opened'] is False and cal['future_observed_agri_used_as_inference_input'] is False
rows=list(csv.DictReader((pack/'val/keys.csv').open(newline='',encoding='utf-8')))
assert len(rows)==66590 and {r['station'] for r in rows}=={'sili','zhujia'}
for seed in (42,43,44):
 for st in ('sili','zhujia'):
  for arm in ('A','AH','AC','ACREL'):
   p=base/st/f'seed{seed}'/arm/'validation_predictions.npz'; m=p.parent/'metrics.json'; c=p.parent/'best.pt'
   assert p.is_file() and m.is_file() and c.is_file(), str(p)
   assert json.load(open(m))['predictions_sha256']==sha(p),str(p)
print('INPUT_CONDITIONED_GATE_PREFLIGHT_PASS train_forecast_oof=1 seeds=3 stations=2 validation_keys='+str(len(rows)))
PY
test ! -e "$RUN"
test ! -e "$AUDIT"
GPU_TEXT=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'node22-gpu/[0-9]+' | cut -d/ -f2 | sort -un)
if [ "$(printf '%s\n' "$GPU_TEXT" | sed '/^$/d' | wc -l)" -ne 3 ]; then echo "REFUSE: expected three distinct node22 GPUs, got $GPU_TEXT"; exit 32; fi
GPU0=$(printf '%s\n' "$GPU_TEXT"|sed -n '1p');GPU1=$(printf '%s\n' "$GPU_TEXT"|sed -n '2p');GPU2=$(printf '%s\n' "$GPU_TEXT"|sed -n '3p')
nvidia-smi -i "$GPU0,$GPU1,$GPU2" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
mkdir -p "$RUN"
CUDA_VISIBLE_DEVICES="$GPU0" python -u train_future_ghi_input_conditioned_gate.py --pack "$PACK" --calibration "$CAL" --output-root "$RUN" --seed 42 --epochs 30 --batch-size 1792 > "$EXP/logs/future_ghi_input_gate_seed42_${PBS_JOBID}.log" 2>&1 & P42=$!
CUDA_VISIBLE_DEVICES="$GPU1" python -u train_future_ghi_input_conditioned_gate.py --pack "$PACK" --calibration "$CAL" --output-root "$RUN" --seed 43 --epochs 30 --batch-size 1792 > "$EXP/logs/future_ghi_input_gate_seed43_${PBS_JOBID}.log" 2>&1 & P43=$!
CUDA_VISIBLE_DEVICES="$GPU2" python -u train_future_ghi_input_conditioned_gate.py --pack "$PACK" --calibration "$CAL" --output-root "$RUN" --seed 44 --epochs 30 --batch-size 1792 > "$EXP/logs/future_ghi_input_gate_seed44_${PBS_JOBID}.log" 2>&1 & P44=$!
set +e
wait "$P42";R42=$?;wait "$P43";R43=$?;wait "$P44";R44=$?
set -e
if [ "$R42" -ne 0 ] || [ "$R43" -ne 0 ] || [ "$R44" -ne 0 ]; then echo "SEED_FAILURE $R42 $R43 $R44"; exit 41; fi
python -u audit_future_ghi_spatial_contrast.py --candidate-root "$RUN" --baseline-root "$BASE" --output "$AUDIT" --candidate-arm ACRELGATE --bootstrap 2000
python - "$RUN" "$AUDIT" <<'PY'
import json,sys
from pathlib import Path
root=Path(sys.argv[1])
for s in (42,43,44):
 m=json.load(open(root/f'seed{s}_manifest.json'))
 assert m['state']=='COMPLETE_FUTURE_GHI_COT_ABLATION_SEED_RUN' and m['arm']=='ACRELGATE'
 assert m['test_payload_opened'] is False and m['buffer_payload_opened'] is False
x=json.load(open(sys.argv[2]))
assert x['state']=='COMPLETE_PAIRED_FUTURE_GHI_COT_ABLATION_VALIDATION_AUDIT' and x['candidate_arm']=='ACRELGATE'
assert x['test_payload_opened'] is False and x['buffer_payload_opened'] is False
print('INPUT_CONDITIONED_GATE_3SEED_AUDIT_COMPLETE',x['equal_station_mean_seed_rmse_wm2'],x['pairwise_delta_rmse_wm2'],x['date_block_bootstrap_95pct_ci_wm2'])
PY
echo "FUTURE_GHI_INPUT_CONDITIONED_GATE_3GPU_COMPLETE test_payload_opened=0 buffer_payload_opened=0"
