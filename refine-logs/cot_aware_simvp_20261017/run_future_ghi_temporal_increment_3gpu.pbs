#!/bin/bash
#PBS -N fgcot_temp_3gpu
#PBS -q gpu
#PBS -l nodes=node22:ppn=16:gpus=3
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /dev/null
set -euo pipefail
PROJECT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$PROJECT/refine-logs/cot_aware_simvp_20261017
PACK=$EXP/results/future_ghi_oof_head_pack_v2
CENTER=$EXP/results/future_cot_oof_reliability_v2/calibration.json
TC=$EXP/results/future_cot_oof_temporal_increment_v1/temporal_increment_calibration.json
RUN=$EXP/results/future_ghi_oof_cot_temporal_increment_v1
BASE=$EXP/results/future_ghi_oof_cot_reliability_v1
AUDIT=$EXP/results/future_ghi_oof_cot_temporal_increment_validation_audit_v1.json
LOG=$EXP/logs/future_ghi_cot_temporal_increment_3gpu_${PBS_JOBID}.log
mkdir -p "$EXP/logs"
exec > >(tee -a "$LOG") 2>&1
cd "$EXP"
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONPYCACHEPREFIX=/tmp/slfu_future_cot_temporal_train_pycache
export LD_PRELOAD="$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_ops_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_infer.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn_cnn_train.so.8:$CONDA_PREFIX/lib/python3.10/site-packages/nvidia/cudnn/lib/libcudnn.so.8"
python -m py_compile train_future_ghi_temporal_increment_cot.py audit_future_ghi_spatial_contrast.py train_future_ghi_heads_cot_reliability.py
python test_future_ghi_spatial_contrast.py
python - "$PACK/pack_manifest.json" "$CENTER" "$TC" <<'PY'
import json,hashlib,sys

def sha(p):
 h=hashlib.sha256()
 with open(p,'rb') as f:
  for b in iter(lambda:f.read(1<<20),b''):h.update(b)
 return h.hexdigest()
p=json.load(open(sys.argv[1]));c=json.load(open(sys.argv[2]));t=json.load(open(sys.argv[3]))
assert p['state']=='COMPLETE_CAUSAL_FUTURE_GHI_HEAD_PACK' and p['train_forecast_oof'] is True and p['forecast_bank_oof_fold_count']==5
assert p['test_payload_opened'] is False and p['buffer_payload_opened'] is False and p['future_observed_agri_used_as_input'] is False and p['cpp_used_as_input'] is False
assert c['forecast_pack_manifest_sha256']==sha(sys.argv[1]) and c['test_payload_opened'] is False and c['buffer_payload_opened'] is False
assert t['state']=='COMPLETE_CROSSFIT_TRAIN_ONLY_COT_TEMPORAL_INCREMENT_AUDIT' and t['forecast_pack_manifest_sha256']==sha(sys.argv[1])
assert t.get('predeclared_cot_pre_gate')=='PASS'
assert t['test_payload_opened'] is False and t['buffer_payload_opened'] is False and t['validation_labels_used_for_fit'] is False and t['future_observed_agri_used_as_inference_input'] is False and t['cpp_used'] is False
assert len(t['fold_by_sequence_index'])>0
print('TEMPORAL_COT_3GPU_PREFLIGHT_PASS')
PY
test ! -e "$RUN"
test ! -e "$AUDIT"
GPU_TEXT=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'node22-gpu/[0-9]+' | cut -d/ -f2 | sort -un)
if [ "$(printf '%s\n' "$GPU_TEXT" | wc -l)" -ne 3 ] || [ -z "$GPU_TEXT" ]; then echo "REFUSE: expected three distinct node22 GPUs, got $GPU_TEXT";exit 32;fi
GPU0=$(printf '%s\n' "$GPU_TEXT"|sed -n '1p');GPU1=$(printf '%s\n' "$GPU_TEXT"|sed -n '2p');GPU2=$(printf '%s\n' "$GPU_TEXT"|sed -n '3p')
nvidia-smi -i "$GPU0,$GPU1,$GPU2" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
CUDA_VISIBLE_DEVICES="$GPU0" python -u train_future_ghi_temporal_increment_cot.py --pack "$PACK" --center-calibration "$CENTER" --temporal-calibration "$TC" --output-root "$RUN" --seed 42 --epochs 30 --batch-size 1792 > "$EXP/logs/future_ghi_temporal_increment_seed42_${PBS_JOBID}.log" 2>&1 & P42=$!
CUDA_VISIBLE_DEVICES="$GPU1" python -u train_future_ghi_temporal_increment_cot.py --pack "$PACK" --center-calibration "$CENTER" --temporal-calibration "$TC" --output-root "$RUN" --seed 43 --epochs 30 --batch-size 1792 > "$EXP/logs/future_ghi_temporal_increment_seed43_${PBS_JOBID}.log" 2>&1 & P43=$!
CUDA_VISIBLE_DEVICES="$GPU2" python -u train_future_ghi_temporal_increment_cot.py --pack "$PACK" --center-calibration "$CENTER" --temporal-calibration "$TC" --output-root "$RUN" --seed 44 --epochs 30 --batch-size 1792 > "$EXP/logs/future_ghi_temporal_increment_seed44_${PBS_JOBID}.log" 2>&1 & P44=$!
set +e
wait "$P42";R42=$?;wait "$P43";R43=$?;wait "$P44";R44=$?
set -e
if [ "$R42" -ne 0 ] || [ "$R43" -ne 0 ] || [ "$R44" -ne 0 ];then echo "SEED_FAILURE $R42 $R43 $R44";exit 41;fi
python -u audit_future_ghi_spatial_contrast.py --candidate-root "$RUN" --baseline-root "$BASE" --output "$AUDIT" --candidate-arm ACRELTEMP --bootstrap 2000
python - "$RUN" "$AUDIT" <<'PY'
import json,sys
for s in (42,43,44):
 m=json.load(open(f'{sys.argv[1]}/seed{s}_manifest.json'));assert m['state']=='COMPLETE_FUTURE_GHI_COT_ABLATION_SEED_RUN' and m['arm']=='ACRELTEMP' and m['test_payload_opened'] is False and m['buffer_payload_opened'] is False
x=json.load(open(sys.argv[2]));assert x['state']=='COMPLETE_PAIRED_FUTURE_GHI_COT_ABLATION_VALIDATION_AUDIT' and x['candidate_arm']=='ACRELTEMP' and x['test_payload_opened'] is False and x['buffer_payload_opened'] is False
print('TEMPORAL_COT_3SEED_PAIRED_AUDIT_COMPLETE',x['pairwise_delta_rmse_wm2'],x['date_block_bootstrap_95pct_ci_wm2'])
PY
echo "FUTURE_GHI_TEMPORAL_INCREMENT_MULTIGPU_COMPLETE test_payload_opened=0 buffer_payload_opened=0"
