#!/bin/bash
#PBS -N fgcot_spatial_audit
#PBS -q gpu
#PBS -l nodes=node22:ppn=8
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /dev/null
set -euo pipefail
PROJECT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$PROJECT/refine-logs/cot_aware_simvp_20261017
PACK=$EXP/results/future_ghi_oof_head_pack_v2
ACTUAL_R=$PROJECT/experiments/monthly_R_station16_20261013_v1/data/ghi_head_pack_new_r_v1
BANK=$EXP/results/future_simvp_r_bank_oof_v1/index.csv
FOLDS=$EXP/results/future_ghi_oof_manifests_v1
CENTER=$EXP/results/future_cot_oof_reliability_v2/calibration.json
OUT=$EXP/results/future_cot_oof_spatial_contrast_v1
LOG=$EXP/logs/future_cot_spatial_contrast_audit_${PBS_JOBID}.log
mkdir -p "$EXP/logs"
exec > >(tee -a "$LOG") 2>&1
cd "$EXP"
sha256sum -c FUTURE_COT_SPATIAL_CONTRAST_SHA256SUMS
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONPYCACHEPREFIX=/tmp/slfu_future_cot_spatial_pycache
python -m py_compile audit_future_cot_spatial_contrast.py train_future_ghi_spatial_contrast.py test_future_ghi_spatial_contrast.py
python test_future_ghi_spatial_contrast.py
test ! -e "$OUT"
python -u audit_future_cot_spatial_contrast.py --forecast-pack "$PACK" --actual-r-pack "$ACTUAL_R" \
  --bank-index "$BANK" --fold-root "$FOLDS" --center-calibration "$CENTER" --output "$OUT" --bootstrap 2000
python - "$OUT/spatial_contrast_calibration.json" <<'PY'
import json,sys
p=sys.argv[1]; d=json.load(open(p))
assert d['state']=='COMPLETE_CROSSFIT_TRAIN_ONLY_SPATIAL_CONTRAST_AUDIT'
assert d['train_rows']==714914 and d['target_bjt_date_blocks']>=20
assert d['cpp_used'] is False and d['validation_labels_used_for_fit'] is False
assert d['test_payload_opened'] is False and d['buffer_payload_opened'] is False
assert d['future_observed_agri_used_as_inference_input'] is False
assert len(d['metrics_by_station_lead_fold'])==160
ci=d['date_block_bootstrap_equal_station_equal_lead_delta_rmse_ci95']
st=d['station_patch_rmse']
passed=(ci[1]<0 and all(st[s]['ACRELSP_patch_rmse_log1p']<=st[s]['ACREL_patch_rmse_log1p'] for s in ('sili','zhujia')))
d['predeclared_cot_pre_gate']='PASS' if passed else 'NO_GO'
d['predeclared_cot_pre_gate_rule']='equal-station/equal-lead fold-excluded patch-RMSE delta CI upper bound below zero and neither station pooled patch RMSE worsens'
open(p,'w').write(json.dumps(d,indent=2)+'\n')
print('SPATIAL_COT_PRE_GATE',d['predeclared_cot_pre_gate'],'delta=',d['equal_station_equal_lead_patch_rmse_log1p']['delta_ACRELSP_minus_ACREL'],'ci=',ci,'station=',st)
PY
if ! grep -q '"predeclared_cot_pre_gate": "PASS"' "$OUT/spatial_contrast_calibration.json"; then
  echo "SPATIAL_COT_PRE_GATE_NO_GO; GPU training not launched"
  exit 0
fi
echo "SPATIAL_COT_PRE_GATE_PASS test_payload_opened=0 buffer_payload_opened=0"
