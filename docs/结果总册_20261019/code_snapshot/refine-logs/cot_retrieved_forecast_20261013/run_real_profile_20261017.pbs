#!/bin/bash
#PBS -N cot_p_profile17
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/refine-logs/cot_retrieved_forecast_20261013/logs/real_profile_20261017.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
BRANCH=$ROOT/refine-logs/cot_retrieved_forecast_20261013
BANK=$ROOT/experiments/monthly_R_station16_20261013_v1/results/new_monthly_R_seed42_cot_bank_v1
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
test ! -e "$BRANCH/results/profile_20261017/profile.json"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
python -u "$BRANCH/profile_retrieved_cot_forecaster_20261017.py" \
  --bank "$BANK" \
  --data-root /public/home/slfu/ttzhou/Auxiliary_data/HuNan_AGRI_Preprocessed \
  --source-dir "$ROOT/scripts" \
  --output "$BRANCH/results/profile_20261017/profile.json"
echo REAL_COT_FORECASTER_PROFILE_COMPLETE
