#!/bin/bash
#PBS -N cot_gate_retry1
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/monthly_R_station16_20261013_v1/logs/cloud_gate_seed42_retry1_20261014.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$ROOT/experiments/monthly_R_station16_20261013_v1
PACK=$EXP/data/pack_trainval_v1
CLP=$EXP/data/clp_trainval_for_gate_20261014/clp_trainval.npz
R=$EXP/results/seed42_v1
OUT=$EXP/results/cloud_gate_seed42_20261014_retry1
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
test -f "$PACK/pack_status.json"
test -f "$CLP"
test ! -e "$OUT"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
python -u "$EXP/scripts/train_cloud_gate_20261014.py" \
  --pack "$PACK" --clp "$CLP" \
  --normalization "$R/normalization.json" \
  --r-validation-prediction "$R/validation_predictions.npz" \
  --output "$OUT" --device cuda:0 --seed 42 --epochs 30 --batch-size 512
echo CLOUD_GATE_SEED42_RETRY1_COMPLETE
