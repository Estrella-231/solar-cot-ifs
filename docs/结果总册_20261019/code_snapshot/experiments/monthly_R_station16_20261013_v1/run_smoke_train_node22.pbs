#!/bin/bash
#PBS -N monthly_R_smoke_train
#PBS -q gpu
#PBS -l nodes=node22:ppn=4:gpus=1
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/monthly_R_station16_20261013_v1/logs/smoke_train_node22.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$ROOT/experiments/monthly_R_station16_20261013_v1
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
test -f "$EXP/data/smoke_patched_trainval_2frames/pack_status.json"
test ! -e "$EXP/results/smoke_train_2frames_v2/status.json"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
python -u "$EXP/scripts/train_station16_R.py" \
  --pack "$EXP/data/smoke_patched_trainval_2frames" \
  --output "$EXP/results/smoke_train_2frames_v2" --seed 42 --epochs 1
echo MONTHLY_R_SMOKE_TRAIN_COMPLETE
