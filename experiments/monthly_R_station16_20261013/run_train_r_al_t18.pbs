#!/bin/bash
#PBS -N t18_r_al_sixfits
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/monthly_R_station16_20261013_v1/logs/t18_r_al_sixfits.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$ROOT/experiments/monthly_R_station16_20261013_v1
FB=$EXP/results/r_al_feature_bank_t18_20261014_v1
PACK=$EXP/data/ghi_head_pack_new_r_v1
OUT=$EXP/results/r_al_formal_t18_20261014_v1
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
test "$(python -c "import json,sys; print(json.load(open(sys.argv[1]))['state'])" "$FB/al_gradient_witness_sili.json")" = PASS_REAL_TRAIN_BATCH_SHAPE_GRADIENT
test "$(python -c "import json,sys; print(json.load(open(sys.argv[1]))['state'])" "$FB/al_gradient_witness_zhujia.json")" = PASS_REAL_TRAIN_BATCH_SHAPE_GRADIENT
test "$(python -c "import json,sys; print(json.load(open(sys.argv[1]))['state'])" "$FB/al_single_card_profile.json")" = PASS_SINGLE_CARD_AL_PROFILE
for station in sili zhujia; do
  for seed in 42 43 44; do
    python -u "$EXP/train_r_al_head.py" --pack "$PACK" --feature-bank "$FB" \
      --station "$station" --seed "$seed" --epochs 30 --batch-size 2000 \
      --output "$OUT/${station}_seed${seed}"
  done
done
echo T18_R_AL_SIX_FITS_COMPLETE
