#!/bin/bash
#PBS -N hb_cot_bank_trainval
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/hubei_r_runtime_gate_20261015_v1/logs/infer_cot_bank.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$ROOT/experiments/hubei_r_runtime_gate_20261015_v1
PACK=$EXP/r_pack_trainval
RUN=$EXP/runs/hubei_R_station16_fixedv2_v1_seed42
OUT=$EXP/cot_bank_trainval
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
test ! -e "$OUT"
python -u "$EXP/infer_hubei_cot_bank_trainval.py" \
  --pack "$PACK" --run "$RUN" --model-source "$ROOT/scripts/train_cot_repaired.py" \
  --output "$OUT" --batch 256
echo HUBEI_COT_BANK_TRAINVAL_COMPLETE_TEST_CLOSED
