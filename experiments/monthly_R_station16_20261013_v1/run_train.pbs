#!/bin/bash
#PBS -N monthly_R_train
#PBS -q gpu
#PBS -l nodes=node22:ppn=8:gpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907/experiments/monthly_R_station16_20261013_v1/logs/train.log
set -euo pipefail
source /public/home/slfu/miniconda3/etc/profile.d/conda.sh
conda activate swc
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1
ROOT=/public/home/slfu/ttzhou/swc/irradiance_forecast/SolarCOTIFS_20260907
EXP=$ROOT/experiments/monthly_R_station16_20261013_v1
GPU=$(/opt/gridview/pbs/dispatcher/bin/qstat -f "$PBS_JOBID" | tr -d '[:space:]' | grep -oE 'gpu/[0-9]+' | cut -d/ -f2 | sort -nu)
test -n "$GPU"
test "$(echo "$GPU" | wc -l)" -eq 1
export CUDA_VISIBLE_DEVICES="$GPU"
test -f "$EXP/data/pack_trainval_v1/pack_status.json"
test ! -e "$EXP/results/seed42_v1/status.json"
PACK="$EXP/data/pack_trainval_v1"
nvidia-smi --id="$GPU" --query-gpu=index,name,memory.used,memory.total,utilization.gpu --format=csv
python -u "$EXP/scripts/audit_monthly_R_pack.py" \
  --pack "$PACK" \
  --output "$EXP/data/pack_trainval_v1/pack_audit.json"
python -u "$EXP/scripts/train_station16_R.py" \
  --pack "$PACK" --output "$EXP/results/seed42_v1" --seed 42 --epochs 50
python -u "$EXP/scripts/audit_monthly_R_validation.py" \
  --pack "$PACK" --run "$EXP/results/seed42_v1" \
  --output "$EXP/results/seed42_v1/validation_audit_fp64.json"
echo NEW_MONTHLY_R_TRAIN_COMPLETE
